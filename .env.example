# ============================================================================
# STREAMLETS MONOREPO - UNIFIED ENVIRONMENT CONFIGURATION
# ============================================================================
#
# This is the SINGLE source of truth for all environment variables across
# the entire monorepo (backend, frontend-extension, frontend-website).
#
# IMPORTANT NOTES:
# ----------------
# 1. Copy this file to `.env` in the root directory and fill in your values
# 2. Both Vite frontends are configured to read from this root .env file
# 3. Cloudflare Workers (backend) uses wrangler.toml for configuration
# 4. The individual package .env.example files are now DEPRECATED
#
# VARIABLE PREFIXES:
# ------------------
# - VITE_* : Exposed to browser (frontend code). Use for public-facing config.
# - No prefix: Backend/server-side only. NEVER expose secrets with VITE_ prefix!
#
# ============================================================================

# ----------------------------------------------------------------------------
# SHARED CONFIGURATION (Used by multiple services)
# ----------------------------------------------------------------------------

# Environment mode (development, staging, production)
NODE_ENV=development

# ----------------------------------------------------------------------------
# BACKEND CONFIGURATION (Cloudflare Workers + Supabase)
# ----------------------------------------------------------------------------
# Note: For Cloudflare Workers deployment, configure these in wrangler.toml
# or via `wrangler secret put` for sensitive values

# Supabase Configuration (Backend - with secret API key for admin operations)
#
# MIGRATION NOTE: Supabase has transitioned to new API key naming:
# - Old: SUPABASE_ANON_KEY → New: SUPABASE_API_KEY_PUBLIC
# - Old: SUPABASE_SERVICE_ROLE_KEY → New: SUPABASE_API_KEY_SECRET
#
# Where to find your API keys:
# 1. Go to Supabase Dashboard: https://supabase.com/dashboard
# 2. Select your project
# 3. Navigate to: Project Settings → API
# 4. Copy "URL" and your API keys:
#    - "anon public" key → SUPABASE_API_KEY_PUBLIC (browser-safe)
#    - "service_role" key → SUPABASE_API_KEY_SECRET (server-only, keep secret!)
#
# IMPORTANT: The Secret API Key has elevated privileges and bypasses Row Level Security.
# NEVER expose it in frontend code or commit it to version control!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY_PUBLIC=your-public-api-key-here
SUPABASE_API_KEY_SECRET=your-secret-api-key-here

# Twitch Extension Configuration (Backend - for JWT verification)
TWITCH_EXTENSION_CLIENT_ID=your-extension-client-id
TWITCH_EXTENSION_SECRET=your-extension-secret-here

# Cloudflare Configuration (for local development with wrangler)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Backend API Base URL (used for internal references)
API_BASE_URL=http://localhost:8787

# ----------------------------------------------------------------------------
# FRONTEND EXTENSION CONFIGURATION (Twitch Extension Panel)
# ----------------------------------------------------------------------------
# These variables are exposed to the browser via Vite's VITE_ prefix
# Server: http://localhost:5173

# API endpoint for the extension to communicate with backend
VITE_API_BASE_URL=http://localhost:8787/api/v1

# Twitch Extension Client ID (public, safe to expose)
VITE_TWITCH_EXTENSION_CLIENT_ID=your-extension-client-id

# Environment mode for frontend
VITE_NODE_ENV=development

# ----------------------------------------------------------------------------
# FRONTEND WEBSITE CONFIGURATION (Public Website)
# ----------------------------------------------------------------------------
# These variables are exposed to the browser via Vite's VITE_ prefix
# Server: http://localhost:5174

# API endpoint for the website to communicate with backend
# Note: Can be different from extension if needed, or same value
# VITE_API_BASE_URL=http://localhost:8787/api/v1  (already defined above)

# Supabase Configuration (Frontend - for client-side auth and queries)
# Uses public API key only - secret key must NEVER be in frontend code!
#
# MIGRATION NOTE: Updated from VITE_SUPABASE_ANON_KEY to VITE_SUPABASE_API_KEY_PUBLIC
# This is the browser-safe public API key for client-side operations.
# Find it in: Supabase Dashboard → Project Settings → API → "anon public" key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_API_KEY_PUBLIC=your-public-api-key-here

# Environment mode for frontend
# VITE_NODE_ENV=development  (already defined above)

# ----------------------------------------------------------------------------
# USAGE INSTRUCTIONS
# ----------------------------------------------------------------------------
# 1. Copy this file: `cp .env.example .env` (or manually create .env)
# 2. Fill in your actual values in the .env file
# 3. The .env file is gitignored and will never be committed
# 4. All packages will automatically read from this root .env file
# 5. For production deployment:
#    - Frontend: Build with production .env values
#    - Backend: Use wrangler secrets or environment variables in deployment
#
# SECURITY REMINDERS:
# - Never commit the actual .env file
# - Never use VITE_ prefix for secrets (they're exposed to browser!)
# - Rotate keys/secrets regularly
# - Use different values for development and production
# ============================================================================
